# ===== Tushare 行情与标的 =====
# Tushare Token
TUSHARE_TOKEN=your_tushare_token
# 票池按序号配置，可持续追加：TICKERS_3_FILE、TICKERS_4_FILE ...
# 支持非连续序号，例如只配置 1、3、8 也可以
TICKERS_1_FILE=tickers_1.txt
TICKERS_2_FILE=tickers_2.txt
POOL_1_NAME=票池1
POOL_2_NAME=票池2
# TICKERS_3_FILE=tickers_3.txt
# POOL_3_NAME=龙头池
# TICKERS_4_FILE=tickers_4.txt
# POOL_4_NAME=自选池
# 分时频率（1MIN,5MIN,15MIN,30MIN,60MIN）
MIN_FREQ=5MIN
# 最少K线数量（KDJ+MACD 建议 >= 35）
MIN_BARS_REQUIRED=35
# 每分钟轮询次数（例如 1 表示每分钟1次，2表示每30秒1次）
POLL_INTERVAL_PER_MINUTES=1
# 相同标的同方向信号的冷却时间（分钟，0表示不冷却）
SIGNAL_COOLDOWN_MINUTES=60
# 心跳日志间隔（分钟，0表示关闭）
HEARTBEAT_INTERVAL_MINUTES=5
# 是否按 A 股交易时段自动启停抓取（true/false）
ENABLE_TRADING_HOURS=true

# ===== 涨跌停封单监控（共用股票池 + 企业微信推送）=====
SEAL_MONITOR_ENABLED=true
# 封单监控轮询间隔（秒）
SEAL_POLL_INTERVAL=2
# 封单减少速率阈值：每 SECOND 封单减少 >= seal_drop_pct_per_sec * poll_interval(%) 触发
SEAL_DROP_PCT_PER_SEC=10
# 封单减少最小手数阈值
SEAL_MIN_DROP_LOTS=100
# 逼近涨停距离阈值（%）
SEAL_NEAR_LIMIT_PCT=1.5
# 逼近涨停每秒买入额阈值（万元）
SEAL_BUY_AMOUNT_PER_SEC=800

# ===== 邮件推送（SMTP）=====
ENABLE_EMAIL=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=your@qq.com
SMTP_PASS=your_smtp_authorization_code
MAIL_FROM=your@qq.com
MAIL_TO=to1@example.com,to2@example.com

# ===== Telegram 推送 =====
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_INTERVAL_SECONDS=30

SUBJECT_PREFIX=[QuantAlert]

# ===== 企业微信推送（Webhook）=====
ENABLE_WECOM=false
# 企业微信 webhook 也按序号配置，需与票池序号一一对应
WEWORK_1_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_first_webhook_key
WEWORK_2_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_second_webhook_key
# WEWORK_3_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_third_webhook_key
# WEWORK_4_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_fourth_webhook_key
WEWORK_SEND_INTERVAL_SECONDS=30

# 备注：
# 1) 当前主程序为 main.py，使用 rt_min 分时数据进行策略计算
# 2) 只要继续追加 TICKERS_N_FILE 与 WEWORK_N_WEBHOOK_URL，就可以扩展更多票池
# 3) 为避免重复提醒，相同 ts_code + bar_time + BUY/SELL + pool_id 只会推送一次
